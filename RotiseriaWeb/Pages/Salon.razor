@page "/salon"
@using RotiseriaWeb.Models
@inject HttpClient Http
@inject ISnackbar Snackbar
@inject NavigationManager Nav

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-4">
    <MudText Typo="Typo.h4" Class="mb-6" Color="Color.Primary">Mapa del Salón</MudText>

    @if (mesas == null)
    {
        <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
    }
    else
    {
        <MudGrid>
            @foreach (var mesa in mesas)
            {
                bool isOcupada = mesa.Status == "Ocupada";
                // Verde oscuro para Libre, Rojo oscuro para Ocupada
                string bgColor = isOcupada ? "#b71c1c" : "#1b5e20";

                <MudItem xs="12" sm="6" md="3">
                    <MudPaper Elevation="4" Class="pa-4 text-center"
                              Style="@($"background-color: {bgColor}; color: white; border-radius: 12px;")">
                        <MudText Typo="Typo.h3"><b>@mesa.Number</b></MudText>
                        <MudText Typo="Typo.subtitle1" Class="mb-2">@mesa.Status</MudText>

                        <MudDivider Class="my-3" Style="background-color: rgba(255,255,255,0.2);" />

                        @if (isOcupada)
                        {
                            <MudButton Variant="Variant.Filled" Style="background-color: white; color: #b71c1c;" Size="Size.Small"
                                       OnClick="@(() => VerCuenta(mesa.Id))" Class="mb-2" FullWidth="true">
                                <b>VER / COBRAR</b>
                            </MudButton>
                            <MudButton Variant="Variant.Outlined" Style="color: white; border-color: white;" Size="Size.Small"
                                       OnClick="IrACaja" FullWidth="true">
                                + Adicionar
                            </MudButton>
                        }
                        else
                        {
                            <MudButton Variant="Variant.Outlined" Style="color: white; border-color: white;" Size="Size.Small"
                                       OnClick="IrACaja" FullWidth="true">
                                Abrir Mesa
                            </MudButton>
                        }
                    </MudPaper>
                </MudItem>
            }
        </MudGrid>
    }
</MudContainer>

@* --- Modal (Cartelito emergente) para ver la cuenta y cobrar --- *@
<MudDialog @bind-Visible="dialogVisible" Options="dialogOptions">
    <TitleContent>
        <MudText Typo="Typo.h5" Color="Color.Primary"><b>Cuenta Mesa @mesaSeleccionada?.Number</b></MudText>
    </TitleContent>
    <DialogContent>
        @if (cuentaActual != null)
        {
            <MudList T="string" Dense="true" Class="mb-2">
                @foreach (var item in cuentaActual.Items)
                {
                    <MudListItem T="string">
                        <div class="d-flex justify-space-between">
                            <MudText>@item.Quantity x @item.ProductName</MudText>
                            <MudText><b>$@(item.UnitPrice * item.Quantity)</b></MudText>
                        </div>
                    </MudListItem>
                }
            </MudList>
            <MudDivider Class="my-2" />
            <div class="d-flex justify-space-between mt-2">
                <MudText Typo="Typo.h6">Total a Pagar:</MudText>
                <MudText Typo="Typo.h5" Color="Color.Primary"><b>$@cuentaActual.Total</b></MudText>
            </div>
        }
        else
        {
            <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="CerrarDialogo">Volver</MudButton>
        <MudButton Color="Color.Success" Variant="Variant.Filled" OnClick="CobrarMesa" Size="Size.Large">
            COBRAR Y LIBERAR
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    private List<Table>? mesas;
    private bool dialogVisible;
    private Table? mesaSeleccionada;
    private Order? cuentaActual;
    private DialogOptions dialogOptions = new() { MaxWidth = MaxWidth.Small, FullWidth = true, CloseButton = true };

    protected override async Task OnInitializedAsync()
    {
        await CargarMesas();
    }

    private async Task CargarMesas()
    {
        mesas = await Http.GetFromJsonAsync<List<Table>>("api/Tables");
    }

    private void IrACaja()
    {
        // Lleva a tu tía a la pantalla principal para tomar el pedido
        Nav.NavigateTo("/");
    }

    private async Task VerCuenta(int tableId)
    {
        mesaSeleccionada = mesas?.FirstOrDefault(m => m.Id == tableId);
        dialogVisible = true;
        cuentaActual = null;

        try
        {
            cuentaActual = await Http.GetFromJsonAsync<Order>($"api/Tables/{tableId}/order");
        }
        catch
        {
            Snackbar.Add("Error al cargar la cuenta", Severity.Error);
            dialogVisible = false;
        }
    }

    private void CerrarDialogo() => dialogVisible = false;

    private async Task CobrarMesa()
    {
        if (mesaSeleccionada == null) return;

        // Avisamos a la API que la mesa se pagó
        var response = await Http.PostAsync($"api/Tables/{mesaSeleccionada.Id}/close", null);

        if (response.IsSuccessStatusCode)
        {
            Snackbar.Add($"¡Mesa {mesaSeleccionada.Number} cobrada con éxito!", Severity.Success);
            dialogVisible = false;
            await CargarMesas(); // Recargamos para que se ponga verde de nuevo
        }
        else
        {
            Snackbar.Add("Hubo un error al cobrar", Severity.Error);
        }
    }
}