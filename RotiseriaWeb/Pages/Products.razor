@page "/products-admin"
@using RotiseriaWeb.Models
@inject HttpClient Http
@inject ISnackbar Snackbar

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-4">
    <MudText Typo="Typo.h4" Class="mb-6" Color="Color.Primary">Gestión del Menú</MudText>

    @* Formulario rápido para agregar un producto *@
    <MudPaper Elevation="4" Class="pa-4 mb-6 rounded-lg">
        <MudGrid AlignItems="AlignItems.Center">
            <MudItem xs="12" sm="3">
                <MudTextField @bind-Value="newProduct.Name" Label="Nombre (Ej: Empanada JyQ)" Variant="Variant.Outlined"
                              Margin="Margin.Dense" />
            </MudItem>
            <MudItem xs="12" sm="2">
                <MudTextField @bind-Value="newProduct.Price" Label="Precio ($)" Variant="Variant.Outlined"
                              Margin="Margin.Dense" Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.AttachMoney" />
            </MudItem>
            <MudItem xs="12" sm="3">
                <MudSelect T="string" @bind-Value="newProduct.Category" Label="Categoría" Variant="Variant.Outlined"
                           Margin="Margin.Dense">
                    <MudSelectItem T="string" Value="@("Comida")">Comida</MudSelectItem>
                    <MudSelectItem T="string" Value="@("Bebida")">Bebida</MudSelectItem>
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="2">
                <MudTextField @bind-Value="newProduct.Stock" Label="Stock (Bebidas)" Variant="Variant.Outlined"
                              Margin="Margin.Dense" Disabled="@(newProduct.Category == "Comida")" />
            </MudItem>
            <MudItem xs="12" sm="2">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" OnClick="AgregarProducto"
                           Disabled="@(string.IsNullOrEmpty(newProduct.Name) || newProduct.Price <= 0)">
                    AGREGAR
                </MudButton>
            </MudItem>
        </MudGrid>
    </MudPaper>

    @* Tabla de productos existentes *@
    <MudTable Items="@products" T="Product" Dense="true" Hover="true" Elevation="4" Class="rounded-lg">
        <HeaderContent>
            <MudTh>Nombre</MudTh>
            <MudTh>Categoría</MudTh>
            <MudTh>Precio</MudTh>
            <MudTh>Stock</MudTh>
            <MudTh>Estado</MudTh>
            <MudTh>Acciones</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd><b>@context.Name</b></MudTd>
            <MudTd>
                <MudChip T="string" Color="@(context.Category == "Bebida" ? Color.Info : Color.Warning)"
                         Size="Size.Small">@context.Category</MudChip>
            </MudTd>
            <MudTd>$ @context.Price</MudTd>
            <MudTd>@(context.Category == "Bebida" ? context.Stock.ToString() : "-")</MudTd>
            <MudTd>
                <MudSwitch T="bool" Value="@context.IsActive"
                           ValueChanged="@(async (bool val) => await ToggleEstado(context))" Color="Color.Success"
                           Label="@(context.IsActive ? "Activo" : "Pausado")" />
            </MudTd>

            @* NUEVOS BOTONES DE ACCIONES *@
            <MudTd>
                <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Info" Size="Size.Small"
                               OnClick="@(() => AbrirEditar(context))" />
                <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small"
                               OnClick="@(() => EliminarProducto(context))" />
            </MudTd>
        </RowTemplate>
    </MudTable>
</MudContainer>

@* --- VENTANA FLOTANTE PARA EDITAR PRODUCTOS --- *@
<MudDialog @bind-Visible="isEditDialogOpen" Options="dialogOptions">
    <TitleContent>
        <MudText Typo="Typo.h6">Editar Producto</MudText>
    </TitleContent>
    <DialogContent>
        <MudTextField @bind-Value="editingProduct.Name" Label="Nombre" Required="true" />
        <MudTextField @bind-Value="editingProduct.Price" Label="Precio" Required="true" />
        <MudSelect T="string" @bind-Value="editingProduct.Category" Label="Categoría">
            <MudSelectItem T="string" Value="@("Comida")">Comida</MudSelectItem>
            <MudSelectItem T="string" Value="@("Bebida")">Bebida</MudSelectItem>
        </MudSelect>
        <MudTextField @bind-Value="editingProduct.Stock" Label="Stock"
                      Disabled="@(editingProduct.Category == "Comida")" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="CerrarEdicion">Cancelar</MudButton>
        <MudButton Color="Color.Success" Variant="Variant.Filled" OnClick="GuardarEdicion">Guardar Cambios</MudButton>
    </DialogActions>
</MudDialog>

@code {
    private List<Product> products = new();
    private Product newProduct = new() { Category = "Comida", Stock = 0, IsActive = true };

    // Variables para el modo de edición
    private bool isEditDialogOpen = false;
    private Product editingProduct = new();
    private DialogOptions dialogOptions = new() { CloseButton = true, MaxWidth = MaxWidth.Small, FullWidth = true };

    protected override async Task OnInitializedAsync()
    {
        await CargarProductos();
    }

    private async Task CargarProductos()
    {
        try
        {
            products = await Http.GetFromJsonAsync<List<Product>>("api/Producto") ?? new();
        }
        catch (Exception)
        {
            Snackbar.Add("Error al cargar menú", Severity.Error);
        }
    }

    private async Task AgregarProducto()
    {
        var response = await Http.PostAsJsonAsync("api/Producto", newProduct);
        if (response.IsSuccessStatusCode)
        {
            Snackbar.Add("Producto agregado al menú", Severity.Success);
            newProduct = new() { Category = "Comida", Stock = 0, IsActive = true };
            await CargarProductos();
        }
    }

    // --- EL BUG DEL 404 SOLUCIONADO ACÁ ---
    private async Task ToggleEstado(Product prod)
    {
        prod.IsActive = !prod.IsActive; // Invertimos el valor

        // Usamos el PUT normal (con el producto entero) en lugar de una ruta inventada /toggle
        var response = await Http.PutAsJsonAsync($"api/Producto/{prod.Id}", prod);

        if (response.IsSuccessStatusCode)
        {
            Snackbar.Add(prod.IsActive ? $"{prod.Name} ahora está a la venta" : $"{prod.Name} pausado", prod.IsActive ?
Severity.Success : Severity.Warning);
        }
        else
        {
            prod.IsActive = !prod.IsActive; // Revertimos si hay error
            Snackbar.Add("Hubo un error al cambiar el estado", Severity.Error);
        }
    }

    // --- LÓGICA DE EDICIÓN ---
    private void AbrirEditar(Product prod)
    {
        // Hacemos una copia exacta para no alterar la tabla hasta que no le dé a "Guardar"
        editingProduct = new Product
        {
            Id = prod.Id,
            Name = prod.Name,
            Price = prod.Price,
            Category = prod.Category,
            Stock = prod.Stock,
            IsActive = prod.IsActive
        };
        isEditDialogOpen = true;
    }

    private void CerrarEdicion()
    {
        isEditDialogOpen = false;
    }

    private async Task GuardarEdicion()
    {
        var response = await Http.PutAsJsonAsync($"api/Producto/{editingProduct.Id}", editingProduct);
        if (response.IsSuccessStatusCode)
        {
            Snackbar.Add("Producto actualizado", Severity.Success);
            isEditDialogOpen = false;
            await CargarProductos(); // Recarga la tabla con los precios nuevos
        }
        else
        {
            Snackbar.Add("Error al actualizar producto", Severity.Error);
        }
    }

    // --- LÓGICA DE ELIMINACIÓN ---
    private async Task EliminarProducto(Product prod)
    {
        var response = await Http.DeleteAsync($"api/Producto/{prod.Id}");
        if (response.IsSuccessStatusCode)
        {
            Snackbar.Add("Producto eliminado", Severity.Success);
            await CargarProductos();
        }
        else
        {
            Snackbar.Add("Error al eliminar", Severity.Error);
        }
    }
}