@page "/"
@using RotiseriaWeb.Models
@using MudBlazor
@inject HttpClient Http
@inject ISnackbar Snackbar
@inject IJSRuntime JS

<MudContainer MaxWidth="MaxWidth.False" Class="mt-4">
    <MudGrid>
        @* COLUMNA IZQUIERDA: PRODUCTOS *@
        <MudItem xs="12" md="8">
            <MudText Typo="Typo.h4" Class="mb-4" Color="Color.Primary">Menú</MudText>

            @* 🔍 BUSCADOR EN TIEMPO REAL *@
            <MudTextField @bind-Value="searchString" Placeholder="Buscar empanada, promo, bebida..."
                          Variant="Variant.Outlined" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                          Class="mb-4" Immediate="true" Clearable="true" />

            <MudGrid>
                @if (products == null)
                {
                    <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
                }
                else if (!FilteredProducts.Any())
                {
                    <MudItem xs="12">
                        <MudText Typo="Typo.body1" Class="text-white-50">No se encontraron productos que coincidan.
                        </MudText>
                    </MudItem>
                }
                else
                {
                    @foreach (RotiseriaWeb.Models.Product prod in FilteredProducts)
                    {
                        <MudItem xs="12" sm="6">
                            <MudCard Elevation="4" Style="background-color: #2a2a2a; color: white;">
                                <MudCardContent>
                                    <MudText Typo="Typo.h6">@prod.Name</MudText>
                                    <MudText Typo="Typo.h5" Color="Color.Primary">$@prod.Price</MudText>
                                </MudCardContent>
                                <MudCardActions>
                                    <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true"
                                               OnClick="@(() => AddToCart(prod))">
                                        AGREGAR
                                    </MudButton>
                                </MudCardActions>
                            </MudCard>
                        </MudItem>
                    }
                }
            </MudGrid>
        </MudItem>

        @* COLUMNA DERECHA: CARRITO *@
        <MudItem xs="12" md="4">
            <MudPaper Elevation="4" Class="pa-4 rounded-lg sticky-top">
                <MudText Typo="Typo.h5" Class="mb-4">Finalizar Pedido</MudText>

                @* Lista de productos agregados *@
                @if (cart.Any())
                {
                    <MudText Typo="Typo.subtitle2" Color="Color.Secondary" Class="mb-2">Productos en el carrito:</MudText>

                    <div class="mb-4 d-flex flex-column gap-2">
                        @foreach (var item in cart)
                        {
                            <MudPaper Elevation="1" Class="pa-2"
                                      Style="background-color: #2a2a2a; color: white; border-radius: 8px;">
                                <div class="d-flex align-center justify-space-between">
                                    <div style="flex-grow: 1;">
                                        <MudText Typo="Typo.body2"><b>@item.ProductName</b></MudText>
                                        <MudText Typo="Typo.caption" Style="color: #bbbbbb;">$@item.UnitPrice c/u</MudText>
                                    </div>
                                    <div class="d-flex align-center">
                                        <MudIconButton Icon="@Icons.Material.Filled.Remove" Size="Size.Small"
                                                       Color="Color.Error" OnClick="@(() => RestarCantidad(item))" />
                                        <MudText Typo="Typo.body2" Class="mx-2">@item.Quantity</MudText>
                                        <MudIconButton Icon="@Icons.Material.Filled.Add" Size="Size.Small" Color="Color.Success"
                                                       OnClick="@(() => AddToCartFromList(item))" />
                                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small"
                                                       Color="Color.Error" OnClick="@(() => RemoveFromCart(item))" Class="ml-1" />
                                    </div>
                                </div>
                            </MudPaper>
                        }
                    </div>

                    <div class="d-flex justify-space-between mb-1">
                        <MudText Typo="Typo.body1" Color="Color.Secondary">Subtotal Comida:</MudText>
                        <MudText Typo="Typo.body1" Color="Color.Secondary"><b>$ @SubtotalCart</b></MudText>
                    </div>

                    @if (orderType == "Delivery")
                    {
                        <div class="d-flex justify-space-between mb-1">
                            <MudText Typo="Typo.body1" Color="Color.Secondary">Costo Envío:</MudText>
                            <MudText Typo="Typo.body1" Color="Color.Secondary"><b>$ @deliveryCost</b></MudText>
                        </div>
                    }

                    <MudDivider Class="my-2" />

                    <div class="d-flex justify-space-between mb-4">
                        <MudText Typo="Typo.h6">Total General:</MudText>
                        <MudText Typo="Typo.h6" Color="Color.Primary"><b>$ @TotalCart</b></MudText>
                    </div>
                }
                else
                {
                    <MudAlert Severity="Severity.Info" Class="mb-4">El carrito está vacío</MudAlert>
                }

                <MudSelect T="string" @bind-Value="orderType" Label="Tipo de Pedido" Variant="Variant.Outlined"
                           Margin="Margin.Dense" Class="mb-2">
                    <MudSelectItem T="string" Value="@("Local")">Mostrador (Para llevar)</MudSelectItem>
                    <MudSelectItem T="string" Value="@("Delivery")">Envío a Domicilio</MudSelectItem>
                    <MudSelectItem T="string" Value="@("Salon")">Comer en Salón (Mesa)</MudSelectItem>
                </MudSelect>

                @if (orderType == "Salon")
                {
                    <MudSelect T="int?" @bind-Value="selectedTableId" Label="Seleccionar Mesa" Variant="Variant.Outlined"
                               Margin="Margin.Dense" Class="mb-2">
                        @foreach (var t in tables)
                        {
                            <MudSelectItem T="int?" Value="@t.Id">
                                Mesa @t.Number @(t.Status == "Ocupada" ? "🔴 (Adicionar)" : "🟢 (Libre)")
                            </MudSelectItem>
                        }
                    </MudSelect>
                }
                else if (orderType == "Delivery")
                {
                    <MudTextField @bind-Value="deliveryAddress" Label="Dirección" Variant="Variant.Outlined"
                                  Margin="Margin.Dense" Class="mb-2" />

                    <MudNumericField T="decimal" @bind-Value="deliveryCost" Label="Costo del Envío ($)"
                                     Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-2" Min="0" />
                }

                @if (orderType != "Salon")
                {
                    <MudSelect T="int?" @bind-Value="selectedCustomerId" Label="Seleccionar Cliente Registrado"
                               Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-2" Clearable="true">
                        @foreach (var c in customers)
                        {
                            <MudSelectItem T="int?" Value="@c.Id">@c.Name</MudSelectItem>
                        }
                    </MudSelect>

                    @if (!selectedCustomerId.HasValue)
                    {
                        <MudTextField @bind-Value="customerName" Label="O escribir nombre ocasional..."
                                      Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-2" />
                    }
                }

                <MudSelect T="string" @bind-Value="selectedPayment" Label="Medio de Pago" Variant="Variant.Outlined"
                           Margin="Margin.Dense" Class="mb-4">
                    <MudSelectItem T="string" Value="@("Efectivo")">Efectivo</MudSelectItem>
                    <MudSelectItem T="string" Value="@("Transferencia")">Transferencia</MudSelectItem>
                    <MudSelectItem T="string" Value="@("Cuenta Corriente")">Cuenta Corriente (Fiado)</MudSelectItem>
                </MudSelect>

                <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" Size="Size.Large"
                           Disabled="@(isProcessing || !cart.Any() || (orderType != "Salon" && !selectedCustomerId.HasValue && string.IsNullOrEmpty(customerName)))"
                           OnClick="ConfirmarPedido">
                    @(isProcessing ? "PROCESANDO..." : "CONFIRMAR ENVIAR A COCINA")
                </MudButton>
            </MudPaper>
        </MudItem>
    </MudGrid>
</MudContainer>

@code {
    private List<Product>? products;
    private List<CartItem> cart = new();
    private List<RotiseriaWeb.Models.Customer> customers = new();
    private List<Table> tables = new();

    private string searchString = ""; // 🔍 Variable para el buscador
    private int? selectedCustomerId;
    private int? selectedTableId;
    private decimal deliveryCost = 1500;

    // Propiedad calculada que filtra en tiempo real
    private IEnumerable<Product> FilteredProducts =>
        string.IsNullOrWhiteSpace(searchString)
            ? (products ?? new List<Product>())
            : (products ?? new List<Product>()).Where(p => p.Name.Contains(searchString, StringComparison.OrdinalIgnoreCase)
                                                      || p.Category.Contains(searchString, StringComparison.OrdinalIgnoreCase));

    private decimal SubtotalCart => cart.Sum(x => x.Quantity * x.UnitPrice);
    private decimal TotalCart => SubtotalCart + (orderType == "Delivery" ? deliveryCost : 0);

    private bool isProcessing = false;
    private string selectedPayment = "Efectivo";
    private string orderType = "Local";
    private string deliveryAddress = "";
    private string customerName = "";

    protected override async Task OnInitializedAsync()
    {
        try
        {
            products = await Http.GetFromJsonAsync<List<Product>>("api/Producto");

            var clientes = await Http.GetFromJsonAsync<List<RotiseriaWeb.Models.Customer>>("api/Customer");
            if (clientes != null) customers = clientes;

            var listaMesas = await Http.GetFromJsonAsync<List<Table>>($"api/Tables?t={DateTime.Now.Ticks}");
            if (listaMesas != null) tables = listaMesas;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error conectando a la API: {ex.Message}");
            Snackbar.Add("No se pudo conectar con el servidor", Severity.Error);
        }
    }

    private void AddToCart(Product prod)
    {
        var item = cart.FirstOrDefault(x => x.ProductId == prod.Id);
        if (item == null)
        {
            cart.Add(new CartItem { ProductId = prod.Id, ProductName = prod.Name, UnitPrice = prod.Price, Quantity = 1 });
        }
        else
        {
            item.Quantity++;
        }
        Snackbar.Add($"{prod.Name} agregado", Severity.Success);
    }

    private void AddToCartFromList(CartItem item)
    {
        item.Quantity++;
    }

    private void RestarCantidad(CartItem item)
    {
        if (item.Quantity > 1)
        {
            item.Quantity--;
        }
        else
        {
            cart.Remove(item);
        }
    }

    private void RemoveFromCard(CartItem item)
    {
        cart.Remove(item);
        Snackbar.Add("Producto quitado", Severity.Info);
    }

    private void RemoveFromCart(CartItem item)
    {
        cart.Remove(item);
        Snackbar.Add("Producto quitado", Severity.Info);
    }

    private async Task ConfirmarPedido()
    {
        if (orderType == "Salon" && !selectedTableId.HasValue)
        {
            Snackbar.Add("Para Salón, debes seleccionar un número de Mesa.", Severity.Warning);
            return;
        }

        if (selectedPayment == "Cuenta Corriente" && !selectedCustomerId.HasValue && orderType != "Salon")
        {
            Snackbar.Add("Para vender por Cuenta Corriente, debes seleccionar un cliente registrado.", Severity.Warning);
            return;
        }

        if (orderType == "Salon" && selectedTableId.HasValue)
        {
            var mesaSeleccionada = tables.FirstOrDefault(t => t.Id == selectedTableId.Value);
            if (mesaSeleccionada != null && mesaSeleccionada.Status == "Ocupada")
            {
                bool confirmado = await JS.InvokeAsync<bool>("confirm", $"¡ATENCIÓN!\nLa Mesa {mesaSeleccionada.Number} ya está OCUPADA.\n\n¿Estás seguro de que querés AGREGAR (adicionar) estos productos a esa misma cuenta?");
                if (!confirmado) return;
            }
        }

        isProcessing = true;

        string finalCustomerName = customerName;
        if (selectedCustomerId.HasValue)
        {
            var cliente = customers.FirstOrDefault(c => c.Id == selectedCustomerId.Value);
            if (cliente != null) finalCustomerName = cliente.Name;
        }

        var nuevoPedido = new Order
        {
            CustomerId = selectedCustomerId,
            ClientName = orderType == "Salon" ? "" : finalCustomerName,
            TableId = orderType == "Salon" ? selectedTableId : null,
            Items = cart.Select(x => new OrderItem
            {
                ProductId = x.ProductId,
                Quantity = x.Quantity
            }).ToList(),
            DeliveryCost = orderType == "Delivery" ? deliveryCost : 0,
            PaymentMethod = selectedPayment,
            DeliveryAddress = orderType == "Delivery" ? deliveryAddress : "",
            OrderType = orderType
        };

        var response = await Http.PostAsJsonAsync("api/Orders", nuevoPedido);

        if (response.IsSuccessStatusCode)
        {
            Snackbar.Add("¡Pedido enviado a cocina y stock actualizado!", Severity.Success);
            cart.Clear();
            customerName = "";
            selectedCustomerId = null;
            selectedTableId = null;
            deliveryAddress = "";
            searchString = "";

            var listaMesas = await Http.GetFromJsonAsync<List<Table>>($"api/Tables?t={DateTime.Now.Ticks}");
            if (listaMesas != null) tables = listaMesas;
        }
        else
        {
            var error = await response.Content.ReadAsStringAsync();
            Snackbar.Add($"Error: {error}", Severity.Error);
        }

        isProcessing = false;
    }
}