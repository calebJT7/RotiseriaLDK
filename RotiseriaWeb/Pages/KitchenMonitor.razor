@page "/cocina"
@using RotiseriaWeb.Models
@inject HttpClient Http
@inject ISnackbar Snackbar
@using System.Timers
@implements IDisposable

<MudText Typo="Typo.h4" Class="mb-4" Color="Color.Primary">Pedidos Activos</MudText>

<MudGrid>
    @foreach (var order in pendingOrders)
    {
        var minutosTranscurridos = (int)(DateTime.Now - order.Date).TotalMinutes;

        // Lógica de colores de alerta (Arreglado para alto contraste con letras blancas)
        var cardColor = "background-color: var(--mud-palette-surface);";
        var showAlert30 = minutosTranscurridos >= 30 && minutosTranscurridos < 45 && !order.Alert30Dismissed;
        var showAlert45 = minutosTranscurridos >= 45;

        // Utilizamos colores oscuros intensos para que el texto blanco resalte desde lejos
        if (showAlert45)
            cardColor = "background-color: #b71c1c; color: white; border: 2px solid #ff5252;"; // Rojo Oscuro
        else if (showAlert30)
            cardColor = "background-color: #e65100; color: white; border: 2px solid #ffb74d;"; // Naranja Oscuro

        <MudItem xs="12" sm="6" md="4">
            <MudCard Elevation="4" Style="@cardColor">
                <MudCardContent>
                    <MudText Typo="Typo.h6" Style="font-weight: bold;">@order.ClientName - @order.OrderType</MudText>
                    <MudText Typo="Typo.body2" Style="color: #eeeeee;">Hace @minutosTranscurridos min</MudText>

                    <MudDivider Class="my-2" Style="background-color: rgba(255,255,255,0.2);" />

                    <MudList T="string" Dense="true">
                        @foreach (var item in order.Items)
                        {
                            <MudListItem T="string">
                                <MudText Typo="Typo.body1"><b>@item.Quantity x @item.ProductName</b></MudText>
                            </MudListItem>
                        }
                    </MudList>
                </MudCardContent>
                <MudCardActions Class="d-flex justify-space-between">
                    @* Botón OK Alerta 30 min *@
                    @if (showAlert30)
                    {
                        <MudButton Style="background-color: #ff9800; color: white;" Variant="Variant.Filled"
                                   OnClick="@(() => DismissAlert(order.Id))">
                            OK (30m)
                        </MudButton>
                    }
                    @* Si pasan 45 min, ya no hay OK, tiene que sacarlo urgente *@
                    @if (showAlert45)
                    {
                        <MudText Style="color: #ffcccc; font-weight: bold;" Typo="Typo.button">DEMORA CRÍTICA</MudText>
                    }

                    <div>
                        @* CORRECCIÓN: Botón Cancelar ahora apunta a api/Orders (con S) *@
                        <MudButton Color="Color.Error" Variant="Variant.Filled" Style="background-color: rgba(255,0,0,0.2);"
                                   OnClick="@(() => CancelarPedido(order.Id))">
                            CANCELAR
                        </MudButton>

                        <MudButton Color="Color.Success" Variant="Variant.Filled"
                                   OnClick="@(() => MarcarDespachado(order.Id))" Class="ml-2">
                            DESPACHAR
                        </MudButton>
                    </div>
                </MudCardActions>
            </MudCard>
        </MudItem>
    }
</MudGrid>

@code {
    private List<Order> pendingOrders = new();
    private Timer _timer;

    protected override async Task OnInitializedAsync()
    {
        await LoadOrders();

        // Hacemos que la pantalla se actualice sola cada 1 minuto (60000 ms) para que el reloj corra
        _timer = new Timer(60000);
        _timer.Elapsed += async (sender, e) => { await InvokeAsync(StateHasChanged); };
        _timer.Start();
    }

    private async Task LoadOrders()
    {
        var allOrders = await Http.GetFromJsonAsync<List<Order>>("api/Orders");
        // Limpié el código duplicado: Solo traemos los que están pendientes
        pendingOrders = allOrders?.Where(o => o.Status == "Pendiente").ToList() ?? new();
    }

    private async Task DismissAlert(int orderId)
    {
        await Http.PatchAsync($"api/Orders/dismiss30m/{orderId}", null);
        var order = pendingOrders.FirstOrDefault(o => o.Id == orderId);
        if (order != null) order.Alert30Dismissed = true;
    }

    private async Task MarcarDespachado(int orderId)
    {
        await Http.PatchAsync($"api/Orders/dispatch/{orderId}", null);
        Snackbar.Add("Pedido entregado", Severity.Success);
        await LoadOrders(); // Recargamos para que desaparezca
    }

    private async Task CancelarPedido(int orderId)
    {
        // CORRECCIÓN: Agregada la 's' a Orders
        await Http.PatchAsync($"api/Orders/cancel/{orderId}", null);
        Snackbar.Add("Pedido Cancelado", Severity.Error);
        await LoadOrders();
    }

    public void Dispose()
    {
        _timer?.Dispose(); // Limpiamos el timer si cambiamos de página
    }
}