@using MudBlazor
@inherits LayoutComponentBase

<MudThemeProvider @bind-IsDarkMode="@_isDarkMode" Theme="_currentTheme" />
<MudDialogProvider />
<MudSnackbarProvider />
<MudPopoverProvider />

<MudLayout>
    <MudAppBar Color="Color.Primary" Elevation="1">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start"
                       OnClick="@((e) => DrawerToggle())" />
        <MudText Typo="Typo.h5" Class="ml-3">ROTISERIA LDK</MudText>
        <MudSpacer />
        @* NUEVO: Botón de Modo Oscuro *@
        <MudToggleIconButton @bind-Toggled="@_isDarkMode" Icon="@Icons.Material.Filled.DarkMode" Color="Color.Inherit"
                             Title="Modo Oscuro" ToggledIcon="@Icons.Material.Filled.LightMode" ToggledColor="Color.Inherit"
                             TitleToggled="Modo Claro" />
    </MudAppBar>

    <MudDrawer @bind-Open="_drawerOpen" Elevation="2" ClipMode="DrawerClipMode.Always">
        <NavMenu />
    </MudDrawer>

    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.False" Class="my-4">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

@code {
    bool _drawerOpen = true;
    void DrawerToggle() => _drawerOpen = !_drawerOpen;

    // Activamos el modo oscuro por defecto
    private bool _isDarkMode = true;

    private MudTheme _currentTheme = new MudTheme()
    {
        PaletteLight = new PaletteLight()
        {
            Primary = "#FF6D00",
            Secondary = "#FFD600",
            AppbarBackground = "#FF6D00",
        },
        PaletteDark = new PaletteDark()
        {
            Primary = "#FF8A65", // Un naranja un poco más suave para la noche
            AppbarBackground = "#27272f",
            Background = "#1a1a27",
            Surface = "#1e1e2d",
        }
    };
}